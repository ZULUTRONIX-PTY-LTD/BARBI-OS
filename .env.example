# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional Additional Free-Tier Provider Keys (Server-Side Only — Never Exposed to Browser):
# GroqCloud LPU Free Tier (30 RPM / 200K TPD)
GROQ_API_KEY=""
# OpenRouter :free Models Aggregator & Mistral (:free) Relay (50-1000 RPD, No Phone SMS)
OPENROUTER_API_KEY=""
# GitHub Models Free Tier (PAT with models:read — No Card / No Phone SMS)
GITHUB_TOKEN=""
# Cerebras Inference Free Developer Tier
CEREBRAS_API_KEY=""
# Mistral La Plateforme Experiment Free Tier (optional; requires Experiment plan + SMS verification)
MISTRAL_API_KEY=""
# Hugging Face Inference Free Tier
HF_TOKEN=""
# Local Edge Ollama Endpoint (e.g., http://localhost:11434)
OLLAMA_BASE_URL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL + pgvector connection parameters (provisioned via Cloud SQL setup)
SQL_HOST=""
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Optional Server-Side Telegram Bot Relay
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
